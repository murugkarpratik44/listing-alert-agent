{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/murugkarpratik44/listing-alert-agent/schemas/sources.schema.json",
  "title": "listing-alert-agent sources (config/sources.yaml)",
  "type": "object",
  "required": ["sources"],
  "additionalProperties": false,
  "properties": {
    "pack": {"type": "string"},
    "sources": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "name", "senders"],
        "additionalProperties": false,
        "properties": {
          "id": {"type": "string", "pattern": "^[a-z0-9-]+$"},
          "name": {"type": "string"},
          "senders": {
            "type": "array",
            "minItems": 1,
            "items": {"type": "string", "pattern": "^[^\\s@]*@[^\\s@]+$"},
            "description": "Exact sender addresses. A pattern like *@site.com is allowed but setup narrows it to the exact address."
          },
          "silence_hours": {"type": "number", "exclusiveMinimum": 0, "default": 48},
          "parser": {"type": "string", "description": "Path of the parser notes inside the pack."},
          "notes": {"type": "string"}
        }
      }
    }
  }
}
